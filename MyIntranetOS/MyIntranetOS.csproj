<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <AssemblyName>MyIntranetOS</AssemblyName>
    <RootNamespace>MyIntranetOS</RootNamespace>
    <Version>1.1.1</Version>
    <Authors>Matheo Mercier; Loris Strange</Authors>
    <!-- Dossier contenant TOUTES les DLL nécessaires (voir libs/README.md) -->
    <LibsPath Condition="'$(LibsPath)' == ''">$(MSBuildThisFileDirectory)libs</LibsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <NovaDll Include="Assembly-CSharp;Assembly-CSharp-firstpass;Mirror;UnityEngine.CoreModule;Newtonsoft.Json;ModKit" />
    <Reference Include="@(NovaDll)">
      <HintPath>$(LibsPath)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copie le dossier MyIntranetOS/ (Web, Application(s), Configuration, Data) à côté de la DLL -->
  <ItemGroup>
    <None Include="MyIntranetOS\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Message clair au lieu de dizaines d'erreurs CS0246 si une DLL manque -->
  <Target Name="CheckNovaDlls" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(LibsPath)/%(NovaDll.Identity).dll')"
           Text="DLL manquante : %(NovaDll.Identity).dll. Copiez-la dans $(LibsPath) (voir libs/README.md)." />
  </Target>

</Project>
